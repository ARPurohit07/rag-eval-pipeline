# Postgres / pgvector (docker-compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword

# Embedding model (sentence-transformers, downloaded from HF Hub on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Chunking
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# Hybrid retrieval
RETRIEVAL_TOP_K=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# Ollama (local daemon proxies to Ollama Cloud once you run `ollama signin`)
OLLAMA_HOST=http://localhost:11434
# Model used to answer questions. Any locally pulled model, or a "-cloud" suffixed
# model (e.g. gpt-oss:120b-cloud) once signed in to Ollama Cloud.
OLLAMA_MODEL=qwen2.5:7b

# Model used as the RAGAS judge (LLM-as-judge for faithfulness/precision/recall).
# Recommend a stronger model here since eval quality depends on judge quality.
RAGAS_JUDGE_MODEL=gpt-oss:120b-cloud
